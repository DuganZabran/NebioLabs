---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Shop" description="Shop Nebio Labs on Etsy — clothing, art, and textiles from Queens, NY.">
  <!-- Hero -->
  <section class="bg-green pt-32 pb-20 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <p class="section-label text-navy/50 mb-6">Shop</p>
      <h1 class="font-raleway font-black text-6xl md:text-8xl uppercase leading-none text-navy">
        Find us<br />on Etsy.
      </h1>
    </div>
  </section>

  <!-- Shop link -->
  <section class="bg-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 items-start">
        <div>
          <p class="section-label text-navy/40 mb-6">Available now</p>
          <p class="text-navy/70 text-lg leading-relaxed mb-10">
            All of our pieces live on Etsy for now — clothing, prints, and textile work. Each item is made in small batches or one-of-a-kind.
          </p>
          <a
            href="https://etsy.com/shop/nebiolabs"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-base px-10 py-4"
          >
            Visit Nebio Labs on Etsy ↗
          </a>
        </div>
        <div class="space-y-4">
          {[
            { label: 'Clothing', desc: 'Garments, wearables, and small-batch pieces.' },
            { label: 'Art & Prints', desc: 'Original works and limited edition prints.' },
            { label: 'Textiles', desc: 'Hand-worked fabric goods and home objects.' },
          ].map(({ label, desc }) => (
            <a
              href="https://etsy.com/shop/nebiolabs"
              target="_blank"
              rel="noopener noreferrer"
              class="flex justify-between items-center border border-navy/10 px-6 py-5 hover:border-green hover:bg-green/5 transition-all group"
            >
              <div>
                <p class="font-raleway font-bold uppercase tracking-widest text-xs text-navy mb-1">{label}</p>
                <p class="text-navy/50 text-sm">{desc}</p>
              </div>
              <span class="text-navy/30 group-hover:text-green transition-colors font-raleway text-lg">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
