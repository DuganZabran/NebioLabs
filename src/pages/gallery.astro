---
import Layout from '@layouts/Layout.astro';

const categories = ['All', 'Clothing', 'Art', 'Textiles'];
---

<Layout title="Gallery" description="Work by Nebio Labs — clothing, art, and textiles from Queens, NY.">
  <!-- Hero -->
  <section class="bg-cream pt-32 pb-16 px-6 md:px-12 border-b border-navy/10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <p class="section-label text-navy/40 mb-4">Work</p>
        <h1 class="font-raleway font-black text-6xl md:text-8xl uppercase leading-none text-navy">Gallery</h1>
      </div>
      <div class="flex gap-3 flex-wrap">
        {categories.map((cat, i) => (
          <button
            class:list={[
              'font-raleway text-xs tracking-ultra uppercase font-semibold px-5 py-2 border transition-colors',
              i === 0
                ? 'bg-navy text-cream border-navy'
                : 'text-navy border-navy/20 hover:border-navy',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="bg-cream px-6 md:px-12 py-16">
    <div class="max-w-6xl mx-auto">
      <!-- Masonry-style grid using CSS columns -->
      <div class="columns-2 md:columns-3 gap-3 space-y-3">
        {Array.from({ length: 9 }).map((_, i) => (
          <div
            class:list={[
              'break-inside-avoid w-full flex items-end p-4',
              i % 4 === 0 ? 'aspect-square bg-terra/20' :
              i % 4 === 1 ? 'aspect-[3/4] bg-navy/10' :
              i % 4 === 2 ? 'aspect-[4/3] bg-green/10' :
                            'aspect-square bg-red/10',
            ]}
          >
            <p class="section-label text-navy/30">Item {i + 1}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-navy/30 font-raleway text-xs tracking-widest uppercase mt-16">
        Photos coming soon — check back or visit Etsy for current pieces.
      </p>
    </div>
  </section>
</Layout>
