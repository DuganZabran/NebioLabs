---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero -->
  <section class="min-h-screen bg-cream flex flex-col justify-end pb-20 px-6 md:px-12 pt-32">
    <div class="max-w-6xl mx-auto w-full">
      <p class="section-label text-navy/40 mb-6">Est. Queens, NY</p>
      <h1 class="font-raleway font-black text-[12vw] md:text-[9vw] leading-none tracking-tight text-navy uppercase mb-8">
        Nebio<br />Labs
      </h1>
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
        <p class="text-lg md:text-xl text-navy/60 max-w-md leading-relaxed font-light">
          Clothing, art &amp; textiles — made with intention.<br />
          <span class="text-navy/30 text-base italic">Tagline coming soon.</span>
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="https://etsy.com/shop/nebiolabs" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Shop on Etsy ↗
          </a>
          <a href="/gallery" class="btn-outline text-navy border-navy hover:bg-navy hover:text-cream">
            View Work
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Color block: What we make -->
  <section class="bg-navy text-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      <div>
        <p class="section-label text-cream/40 mb-6">What we make</p>
        <h2 class="font-raleway font-black text-5xl md:text-6xl uppercase leading-none mb-8">
          Made<br /><span class="text-green">by hand.</span><br />Worn<br />with care.
        </h2>
      </div>
      <div class="space-y-6">
        {[
          { label: 'Clothing', desc: 'One-of-a-kind garments and small-batch pieces you won\'t find anywhere else.' },
          { label: 'Art & Prints', desc: 'Original works and prints — the kind that feel right in a lived-in apartment.' },
          { label: 'Textiles', desc: 'Hand-worked fabric goods with texture, color, and a bit of character.' },
        ].map(({ label, desc }) => (
          <div class="border-t border-cream/10 pt-6">
            <p class="font-raleway font-bold tracking-widest uppercase text-xs text-green mb-2">{label}</p>
            <p class="text-cream/70 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="bg-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-end mb-12">
        <div>
          <p class="section-label text-navy/40 mb-3">Recent work</p>
          <h2 class="font-raleway font-black text-4xl md:text-5xl uppercase text-navy">Gallery</h2>
        </div>
        <a href="/gallery" class="btn-outline text-navy border-navy hover:bg-navy hover:text-cream hidden md:inline-block">
          See all
        </a>
      </div>
      <!-- Placeholder grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {Array.from({ length: 6 }).map((_, i) => (
          <div
            class:list={[
              'aspect-square flex items-end p-4',
              i % 3 === 0 ? 'bg-terra/20' : i % 3 === 1 ? 'bg-navy/10' : 'bg-green/10',
            ]}
          >
            <p class="section-label text-navy/30">Photo {i + 1}</p>
          </div>
        ))}
      </div>
      <a href="/gallery" class="btn-outline text-navy border-navy hover:bg-navy hover:text-cream mt-8 md:hidden inline-block">
        See all work
      </a>
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-terra px-6 md:px-12 py-20">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
      <h2 class="font-raleway font-black text-4xl md:text-5xl uppercase text-cream leading-tight">
        Find us<br />on Etsy.
      </h2>
      <a
        href="https://etsy.com/shop/nebiolabs"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-cream text-navy font-raleway font-bold tracking-widest uppercase text-sm px-8 py-3 hover:bg-navy hover:text-cream transition-colors"
      >
        Shop Nebio Labs ↗
      </a>
    </div>
  </section>
</Layout>
