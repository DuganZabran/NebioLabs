---
import Layout from '@layouts/Layout.astro';
---

<Layout title="About" description="About Nebio Labs — clothing, art, and textiles from Queens, NY.">
  <!-- Hero -->
  <section class="bg-navy text-cream pt-32 pb-20 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <p class="section-label text-cream/30 mb-6">About</p>
      <h1 class="font-raleway font-black text-6xl md:text-8xl uppercase leading-none text-cream">
        Nebio<br /><span class="text-green">Labs.</span>
      </h1>
    </div>
  </section>

  <!-- Story -->
  <section class="bg-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16">
      <div>
        <p class="section-label text-navy/40 mb-6">The story</p>
        <div class="space-y-5 text-navy/80 leading-relaxed text-lg">
          <p>
            Nebio Labs is a creative studio out of Queens, NY making clothing, art, and textiles — the kind of things you pick up at an open market and carry with you for years.
          </p>
          <p>
            <!-- Add your story here -->
            More about the studio coming soon.
          </p>
        </div>
      </div>
      <!-- Placeholder image -->
      <div class="bg-terra/20 aspect-[4/5] flex items-end p-6">
        <p class="section-label text-navy/30">Studio photo</p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-navy text-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto">
      <p class="section-label text-cream/30 mb-12">How we work</p>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: 'Handmade', body: 'Every piece is made by hand, one at a time. No mass production.' },
          { title: 'Local', body: 'Rooted in Queens. Inspired by NYC\'s open art markets and creative community.' },
          { title: 'Intentional', body: 'Materials are chosen carefully. Nothing is made just to fill a shelf.' },
        ].map(({ title, body }) => (
          <div class="border-t border-cream/10 pt-8">
            <h3 class="font-raleway font-bold text-2xl text-green mb-4 uppercase tracking-wide">{title}</h3>
            <p class="text-cream/60 leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-cream px-6 md:px-12 py-20 border-t border-navy/10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
      <h2 class="font-raleway font-black text-4xl uppercase text-navy">See the work.</h2>
      <div class="flex gap-4">
        <a href="/gallery" class="btn-primary">Gallery</a>
        <a href="/contact" class="btn-outline text-navy border-navy hover:bg-navy hover:text-cream">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>
