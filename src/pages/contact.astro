---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Nebio Labs.">
  <!-- Hero -->
  <section class="bg-navy text-cream pt-32 pb-16 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
      <p class="section-label text-cream/30 mb-6">Contact</p>
      <h1 class="font-raleway font-black text-6xl md:text-8xl uppercase leading-none">
        Say<br /><span class="text-terra">hello.</span>
      </h1>
    </div>
  </section>

  <!-- Form + info -->
  <section class="bg-cream px-6 md:px-12 py-24">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-start">
      <!-- Form -->
      <div>
        <p class="section-label text-navy/40 mb-8">Send a message</p>
        <form
          name="contact"
          method="POST"
          class="space-y-6"
        >
          <div>
            <label for="name" class="section-label text-navy/50 block mb-2">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="Your name"
              class="w-full border border-navy/20 bg-transparent px-4 py-3 text-navy placeholder-navy/30 focus:outline-none focus:border-green transition-colors font-sans"
            />
          </div>
          <div>
            <label for="email" class="section-label text-navy/50 block mb-2">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="your@email.com"
              class="w-full border border-navy/20 bg-transparent px-4 py-3 text-navy placeholder-navy/30 focus:outline-none focus:border-green transition-colors font-sans"
            />
          </div>
          <div>
            <label for="subject" class="section-label text-navy/50 block mb-2">Subject</label>
            <input
              id="subject"
              name="subject"
              type="text"
              placeholder="Commission, collab, general..."
              class="w-full border border-navy/20 bg-transparent px-4 py-3 text-navy placeholder-navy/30 focus:outline-none focus:border-green transition-colors font-sans"
            />
          </div>
          <div>
            <label for="message" class="section-label text-navy/50 block mb-2">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="What's on your mind?"
              class="w-full border border-navy/20 bg-transparent px-4 py-3 text-navy placeholder-navy/30 focus:outline-none focus:border-green transition-colors font-sans resize-none"
            ></textarea>
          </div>
          <button type="submit" class="btn-primary w-full text-center">
            Send Message
          </button>
        </form>
      </div>

      <!-- Info -->
      <div class="space-y-12">
        <div>
          <p class="section-label text-navy/40 mb-4">Find us</p>
          <p class="text-navy/60 leading-relaxed">
            Queens, New York<br />
            Open to collabs, commissions, and market inquiries.
          </p>
        </div>
        <div>
          <p class="section-label text-navy/40 mb-4">On the web</p>
          <div class="space-y-3">
            <a
              href="https://instagram.com/nebiolabs"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-navy/60 hover:text-green transition-colors font-raleway text-xs tracking-widest uppercase font-semibold"
            >
              <span class="w-8 h-px bg-current"></span>
              Instagram ↗
            </a>
            <a
              href="https://etsy.com/shop/nebiolabs"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 text-navy/60 hover:text-green transition-colors font-raleway text-xs tracking-widest uppercase font-semibold"
            >
              <span class="w-8 h-px bg-current"></span>
              Etsy Shop ↗
            </a>
          </div>
        </div>
        <!-- Decorative color block -->
        <div class="bg-terra aspect-video flex items-end p-6">
          <p class="font-raleway font-black text-2xl uppercase text-cream leading-tight">
            Made in<br />Queens.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
