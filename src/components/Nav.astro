---
const links = [
  { label: 'Work', href: '/gallery' },
  { label: 'About', href: '/about' },
  { label: 'Shop', href: '/shop' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-multiply">
  <nav class="flex items-center justify-between px-6 md:px-12 py-5 bg-cream border-b border-navy/10">
    <a href="/" class="font-raleway font-black text-xl tracking-widest uppercase text-navy hover:text-green transition-colors">
      Nebio Labs
    </a>
    <ul class="hidden md:flex items-center gap-10">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={[
              'font-raleway text-xs tracking-ultra uppercase font-semibold transition-colors duration-150',
              currentPath === href ? 'text-green' : 'text-navy hover:text-terra',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <!-- Mobile menu toggle -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
      <span class="w-6 h-0.5 bg-navy block transition-all"></span>
      <span class="w-6 h-0.5 bg-navy block transition-all"></span>
      <span class="w-4 h-0.5 bg-navy block transition-all"></span>
    </button>
  </nav>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream border-b border-navy/10 px-6 py-6">
    <ul class="flex flex-col gap-5">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="font-raleway text-sm tracking-widest uppercase font-semibold text-navy hover:text-green transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
